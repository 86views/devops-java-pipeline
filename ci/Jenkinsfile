pipeline {
    agent any

    environment {
        APP_NAME       = 'spring-petclinic'
        BUILD_TAG      = "v2.${BUILD_NUMBER}"
        COMPOSE_FILE   = 'docker/docker-compose.stage1.yml'
        SONAR_TOKEN    = credentials('SONAR_TOKEN')
        REGISTRY_CREDS = credentials('DOCKERHUB_CREDS')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "===> Checking out code for build #${BUILD_NUMBER}"
                checkout scm
            }
        }

        stage('Build & Unit Test') {
            steps {
                echo "===> Running Maven Build and Tests"
                sh './ci/scripts/build.sh'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'app/spring-petclinic/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '===> Executing SonarQube Code Quality & Security Scan'
                sh './ci/scripts/sonar.sh'
            }
        }

        stage('Container Build') {
            steps {
                echo "===> Building Application Image"
                sh "./ci/scripts/docker-build.sh ${APP_NAME}:${BUILD_TAG}"
            }
        }

        stage('Trivy Security Scan') {
            steps {
                echo '===> Scanning Container Image for High & Critical Vulnerabilities'
                sh "./ci/scripts/trivy-scan.sh ${APP_NAME}:${BUILD_TAG}"
            }
        }

        stage('Push to Registry') {
            steps {
                echo '===> Authenticating and Pushing Image to Docker Hub'
                sh '''
                    echo "$REGISTRY_CREDS_PSW" | docker login -u "$REGISTRY_CREDS_USR" --password-stdin
                    DOCKERHUB_USER="$REGISTRY_CREDS_USR" ./ci/scripts/docker-push.sh ${BUILD_TAG}
                '''
            }
        }

        stage('Local Deploy') {
            steps {
                echo "===> Deploying Stage 1 Environment"
                sh './ci/scripts/deploy.sh'
            }
        }

        stage('Verification') {
            steps {
                echo "===> Verifying Stage 1 Deployments"
                sh '''
                    sleep 10
                    curl -s -f http://nginx:80/healthz || exit 1

                    echo "Nginx reverse proxy is active and healthy!"
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo "Stage 2 Pipeline completed successfully!"
        }
        failure {
            echo "Stage 2 Pipeline failed. Check logs above."
        }
    }
}
